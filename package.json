        "postcss-cli": "^11.0.0",
        "postcss-import": "^16.1.0",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "driver.js": "^1.2.1"
    }
